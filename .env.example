# Required: server-only MongoDB Atlas URI and explicit database name.
# Replace the placeholder with your Atlas connection string; URL-encode credentials.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=cadence

# Local development alternative: a replica set is required for transactions.
# MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0

# Optional AI provider; omitted means the deterministic rule engine is used.
# OPENAI_API_KEY=sk-...
# AI_MODEL=gpt-4o-mini
# AI_TIMEOUT_MS=15000
